# ==============================================================================
# agriBID - Git Ignore Policy
# ==============================================================================

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Logs & Temporary Data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.tmp

# Environment Variables & Secrets
.env
.env.local
.env.production
.env.development
.env.staging
!.env.example
!.env.local.example

# Node.js & Next.js Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/*.tsbuildinfo
frontend/.vercel/

# Go Backend Binaries & Build Output
backend/server
backend/server.exe
backend/*.exe
backend/*.out
backend/bin/
backend/dist/
backend/coverage.out

# Database & Storage Files
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite
test_agribid.db
agribid.db
